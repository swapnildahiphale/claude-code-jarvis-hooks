ENGINEER_NAME=YourName

CLAUDE_HOOKS_OPENAI_API_KEY=your_openai_api_key_here
CLAUDE_HOOKS_OPENAI_API_BASE_URL=https://api.openai.com/v1
CLAUDE_HOOKS_OPENAI_MODEL="gpt-4.1-nano"

ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_voice_id_here
ELEVENLABS_MODEL_ID = eleven_turbo_v2_5

# Optional: seconds to wait for transcript file to settle before reading (stop hook)
JARVIS_TRANSCRIPT_SETTLE_SECS=2

# Optional: local JARVIS voice via jarvis-say (requires jarvis-voice setup; macOS/local only)
JARVIS_USE_LOCAL_TTS=false
# JARVIS_SAY_PATH=/opt/homebrew/bin/jarvis-say
# JARVIS_SAY_TIMEOUT=120
